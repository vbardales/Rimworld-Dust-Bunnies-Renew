<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>GatherDust</defName>
    <label>gather dust</label>
    <description>Gather up dust to make dust.</description>
    <jobString>Gathering dust.</jobString>
    <workSkillLearnFactor>0.001</workSkillLearnFactor>
    <soundWorking>Interact_ConstructDirt</soundWorking>
    <workAmount>250</workAmount>
    <products>
      <Dust>10</Dust>
    </products>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <!--
    No <products>. The dust bunny is not an item that gets dropped and hauled: the worker
    below spawns a live pawn when the iteration completes. A productless recipe is legal -
    RecipeWorkerCounter.CanCountProducts returns false for it, so "do until you have X" is
    refused with a message instead of counting a product that does not exist.
  -->
  <RecipeDef>
    <defName>MakeDustBunny</defName>
    <label>make a dust bunny</label>
    <description>Make a dust bunny. Made from dust.</description>
    <jobString>Making a dust bunny.</jobString>
    <workerClass>DustBunnies.Recipe_SpawnDustBunny</workerClass>
    <workSkillLearnFactor>0.001</workSkillLearnFactor>
    <soundWorking>Interact_ConstructDirt</soundWorking>
    <allowMixingIngredients>false</allowMixingIngredients>
    <workAmount>800</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Dust</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Dust</li>
      </thingDefs>
    </fixedIngredientFilter>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

</Defs>

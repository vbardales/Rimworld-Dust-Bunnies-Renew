# Normalise line endings in this repository, while each machine keeps its own.
# The monorepo has its own copy; `git subtree split` does not export it, so this
# one exists for the repository this mod is split into.

* text=auto

*.xml   text
*.md    text
*.txt   text
*.cs    text
*.csproj text
*.props text

*.png binary
*.psd binary
*.dll binary

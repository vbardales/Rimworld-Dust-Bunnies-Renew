<Project>

  <PropertyGroup>
    <!--
      Build intermediates go outside the mod folder. RimWorld's Workshop uploader sends the whole
      directory (SteamUGC.SetItemContent on the root, no exclusion possible): leaving obj/ inside
      it means publishing the publicised Assembly-CSharp.dll, and so redistributing the game's
      own code. This has to stay in a Directory.Build.props - NuGet restore reads the property
      before the csproj is evaluated.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\DustBunnies\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\DustBunnies\</BaseOutputPath>
  </PropertyGroup>

</Project>
